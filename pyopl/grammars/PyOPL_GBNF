root ::= _ ( model | data_file ) _

_ ::= ( [ \t\r\n] | line_comment | hash_comment | block_comment )*
line_comment ::= "//" [^\n]*
hash_comment ::= "#" [^\n]*
block_comment ::= "/*" ( [^*] | "*" [^/] )* "*/"


// --- Tokens and atoms ---
NAME ::= [A-Za-z_] [A-Za-z0-9_]*
NUMBER ::= ( [0-9]+ ( "." [0-9]+ )? | "." [0-9]+ ) ( [eE] [+\-]? [0-9]+ )?
SIGNED_NUMBER ::= "-"? NUMBER
DATA_NUMBER ::= [+-]? NUMBER
BOOLEAN_LITERAL ::= "true" | "false"
STRING_LITERAL ::= "\"" [^"]* "\""

// The active lexers reserve true/false by prefix, so names beginning with either
// word are not usable even though that exclusion is not expressible in NAME above.

// Operators and symbols appear as literals in productions.

// ------------ MODEL GRAMMAR ------------
// Implementation allows objective section either before or after subject-to block.
model ::= declarations_opt ( objective_section constraints_section | constraints_section objective_section )

declarations_opt ::= declaration*
declaration_list ::= declaration+
objective_section ::= "minimize" _ expression _ ";" _
                   | "maximize" _ expression _ ";" _
                   | "minimize" _ NAME _ ":" _ expression _ ";" _
                   | "maximize" _ NAME _ ":" _ expression _ ";" _
                   | "minimize" _ NAME _ "=" _ expression _ ";" _
                   | "maximize" _ NAME _ "=" _ expression _ ";" _

constraints_section ::= "subject" _ "to" _ "{" _ constraint_list_opt "}" _
constraint_list_opt ::= constraint*
constraint_list ::= constraint+

// Constraint forms
constraint ::=
  expression _ ";" _
    | NAME _ ":" _ expression _ ";" _
    | "forall" _ forall_index_header _ constraint _
    | "forall" _ forall_index_header _ constraint_block _
    | "if" _ "(" _ expression _ ")" _ constraint _
    | "if" _ "(" _ expression _ ")" _ constraint _ "else" _ constraint _
    | NAME _ ":" _ "if" _ "(" _ expression _ ")" _ constraint _
    | NAME _ ":" _ "if" _ "(" _ expression _ ")" _ constraint _ "else" _ constraint _
    | "if" _ "(" _ expression _ ")" _ constraint_block _
    | "if" _ "(" _ expression _ ")" _ constraint_block _ "else" _ constraint_block _
    | NAME _ ":" _ "if" _ "(" _ expression _ ")" _ constraint_block _
    | NAME _ ":" _ "if" _ "(" _ expression _ ")" _ constraint_block _ "else" _ constraint_block _

constraint_block ::= "{" _ constraint_list _ "}" _

// --- Declarations (grouped) ---
declaration ::=
      dvar_declaration
    | range_declaration
    | untyped_set_declaration
    | typed_set_declaration
    | set_of_tuples_declaration
    | set_of_tuples_array_declaration
    | untyped_tuple_set_assignment
    | tuple_type_declaration
    | tuple_array_declaration
    | param_declaration
    | dexpr_declaration

// --- Types
dvar_type ::= "int" | "float" | "int+" | "float+" | "boolean"
type      ::= "int" | "float" | "int+" | "float+" | "boolean" | "string" | NAME

// --- dvar
dvar_declaration ::=
      "dvar" _ dvar_type _ NAME _ ";" _
    | "dvar" _ dvar_type _ NAME _ indexed_dimensions _ ";" _
    | "dvar" _ dvar_type _ NAME _ dexpr_index_headers _ "in" _ expression _ ".." _ expression _ ";" _

// --- range
range_declaration ::=
      "range" _ NAME _ "=" _ range_expr _ ".." _ range_expr _ ";" _
    | "range" _ NAME _ ";" _

// --- plain untyped set symbol (no RHS)
untyped_set_declaration ::= "set" _ NAME _ ";" _

// --- typed scalar sets (strings, ints, floats, booleans)
typed_set_declaration ::=
      "{" _ "string" _ "}" _ NAME _ "=" _ "{" _ element_list_string _ "}" _ ";" _
    | "{" _ "string" _ "}" _ NAME _ ";" _
    | "{" _ "string" _ "}" _ NAME _ "=" _ "..." _ ";" _
    | "{" _ "int" _ "}" _ NAME _ "=" _ "{" _ element_list_int _ "}" _ ";" _
    | "{" _ "int" _ "}" _ NAME _ "=" _ "{" _ scalar_comprehension _ "}" _ ";" _
    | "{" _ "int" _ "}" _ NAME _ ";" _
    | "{" _ "int" _ "}" _ NAME _ "=" _ "..." _ ";" _
    | "{" _ "float" _ "}" _ NAME _ "=" _ "{" _ element_list_float _ "}" _ ";" _
    | "{" _ "float" _ "}" _ NAME _ ";" _
    | "{" _ "float" _ "}" _ NAME _ "=" _ "..." _ ";" _
    | "{" _ "boolean" _ "}" _ NAME _ "=" _ "{" _ element_list_boolean _ "}" _ ";" _
    | "{" _ "boolean" _ "}" _ NAME _ ";" _
    | "{" _ "boolean" _ "}" _ NAME _ "=" _ "..." _ ";" _

// Note: empty literal sets like `{}` are not accepted by the current parser.
element_list_string  ::= STRING_LITERAL (_ "," _ STRING_LITERAL)*
element_list_int     ::= SIGNED_NUMBER_INT (_ "," _ SIGNED_NUMBER_INT)*
element_list_float   ::= SIGNED_NUMBER (_ "," _ SIGNED_NUMBER)*
element_list_boolean ::= BOOLEAN_LITERAL (_ "," _ BOOLEAN_LITERAL)*

// Filtered scalar comprehensions are currently accepted for {int} declarations only.
scalar_comprehension ::= scalar_comprehension_value _ "|" _ sum_index_list _ opt_index_constraint
scalar_comprehension_value ::= NAME | NUMBER | STRING_LITERAL

// Helpers to constrain ints in {int} element lists
NUMBER_INT ::= [0-9]+
SIGNED_NUMBER_INT ::= "-"? NUMBER_INT

// --- set of tuples (typed by tuple type)
set_of_tuples_declaration ::=
      "{" _ NAME _ "}" _ NAME _ "=" _ "{" _ tuple_literal_list_model _ "}" _ ";" _
    | "{" _ NAME _ "}" _ NAME _ ";" _
    | "{" _ NAME _ "}" _ NAME _ "=" _ "..." _ ";" _
    | "{" _ NAME _ "}" _ NAME _ "=" _ "{" _ tuple_comprehension _ "}" _ ";" _

// External indexed array whose value at each index is a set of tuples.
set_of_tuples_array_declaration ::=
      "{" _ NAME _ "}" _ NAME _ indexed_dimensions _ "=" _ "..." _ ";" _

// --- untyped set-of-tuples assignment (model; only tuple literals allowed on RHS)
untyped_tuple_set_assignment ::= NAME _ "=" _ "{" _ tuple_literal_list_model _ "}" _ ";" _

// --- tuple type
tuple_type_declaration ::= "tuple" _ NAME _ "{" _ tuple_field_list_opt _ "}" _ opt_semicolon
tuple_field_list_opt ::= (tuple_field (_ tuple_field)*)?
tuple_field ::= type _ NAME _ ";" _
opt_semicolon ::= (";" _)?


# --- tuple arrays (model)
tuple_array_declaration ::=
      NAME _ NAME _ named_dimensions _ "=" _ "..." _ ";" _
    | NAME _ NAME _ named_dimensions _ ";" _
named_dimensions ::= ("[" _ NAME _ "]" _)+

// --- param declarations
param_declaration ::=
    // scalar or indexed external, optional 'param', optional '= ...'
      opt_param_kw _ type _ NAME _ opt_indexed _ opt_assign_ellipsis _ ";" _
    // scalar inline number
    | opt_param_kw _ type _ NAME _ "=" _ NUMBER _ ";" _
    // scalar inline general expression
    | opt_param_kw _ type _ NAME _ "=" _ expression _ ";" _
    // indexed inline array literal
    | opt_param_kw _ type _ NAME _ indexed_dimensions _ "=" _ array_value _ ";" _
    // computed indexed parameter with iterators: float p[i in I, j in J] = expr;
    | opt_param_kw _ type _ NAME _ dexpr_index_header _ "=" _ expression _ ";" _
    // computed indexed parameter with strict nested headers: float p[i in I][j in J] = expr;
    | opt_param_kw _ type _ NAME _ dexpr_index_headers _ "=" _ expression _ ";" _

// --- dexpr declarations (decision expressions; expanded on use)
dexpr_declaration ::=
      "dexpr" _ type _ NAME _ "=" _ expression _ ";" _
    | "dexpr" _ type _ NAME _ dexpr_index_header _ "=" _ expression _ ";" _
    | "dexpr" _ type _ NAME _ dexpr_index_headers _ "=" _ expression _ ";" _

// dexpr index header: [ i in I, j in J ]
dexpr_index_header ::= "[" _ dexpr_index_list _ "]" _
dexpr_index_headers ::= "[" _ dexpr_index_list _ "]" _ ( "[" _ dexpr_index_list _ "]" _ )*
dexpr_index_list ::= dexpr_index (_ "," _ dexpr_index)*
dexpr_index ::= NAME _ "in" _ IN_RANGE

// --- indexed dimensions and ranges
indexed_dimensions ::= ( "[" _ index_specifier _ "]" _ )+
index_specifier ::=
      expression _ ".." _ expression          // range index
    | expression                              // general index: name/number/arith/field/string/tuple literal
    | tuple_literal_model                      // tuple literal index for tuple-set dims

range_expr ::= expression                     // must be int-valued (semantic)

// Shared in sum/forall/dexpr
IN_RANGE ::= ( expression _ ".." _ expression ) | NAME | NAME _ indexed_dimensions

// --- forall/sum headers
forall_index_header ::= "(" _ sum_index_list _ opt_index_constraint _ ")" _
sum_index_header    ::= "(" _ sum_index_list _ opt_index_constraint _ ")" _

sum_index_list ::= sum_index (_ "," _ sum_index)*
sum_index ::= NAME _ "in" _ IN_RANGE

opt_index_constraint ::= ( ":" _ expression )?


// --- Expressions (precedence tower; no left recursion) ---
// Implication is right-associative and is available anywhere an expression is accepted.
expression ::= implication_expr
implication_expr ::= conditional_expr ( _ "=>" _ implication_expr )?

// conditional ternary – condition must be parenthesized (per spec and parser)
conditional_expr ::=
      logic_or_expr
    | "(" _ expression _ ")" _ "?" _ expression _ ":" _ expression

logic_or_expr  ::= logic_and_expr ( _ "||" _ logic_and_expr )*
logic_and_expr ::= equality_expr ( _ "&&" _ equality_expr )*

equality_expr ::= relational_expr ( _ ( "==" | "!=" ) _ relational_expr )*
// Implementation rejects chained relational comparisons like `a < b < c`.
relational_expr ::= additive_expr ( _ ( "<=" | "<" | ">=" | ">" ) _ additive_expr )?

additive_expr ::= multiplicative_expr ( _ ( "\+" | "-" ) _ multiplicative_expr )*
multiplicative_expr ::= unary_expr ( _ ( "\*" | "/" | "%" ) _ unary_expr )*

unary_expr ::= ( ( "-" | "!" ) _ )* postfix_expr

// postfix: ONLY field access chaining (no generic call-args)
// function calls are handled explicitly via function_call primary
postfix_expr ::= primary ( _ field_access )*
field_access ::= "." _ NAME

// Primaries, including aggregates and function calls
primary ::=
      NUMBER
    | STRING_LITERAL
    | BOOLEAN_LITERAL
    | NAME
    | NAME _ indexed_dimensions
    | "(" _ expression _ ")"
    | tuple_literal_model
    | sum_expression
    | min_aggregate
    | max_aggregate
    | function_call

// Function calls: unary algebraic functions plus maxl/minl
function_call ::=
  ("sqrt" | "exp" | "log" | "sin" | "cos" | "tan" | "abs" | "floor" | "ceil" | "round") _ "(" _ expression _ ")"
    | "maxl" _ "(" _ arg_list _ ")"     // require non-empty
    | "minl" _ "(" _ arg_list _ ")"     // require non-empty

arg_list ::= expression ( _ "," _ expression )*

// --- Tuple literals
// Model tuple components use a restricted arithmetic tower shared with comprehensions.
tuple_literal_model ::= "<" _ tuple_element_list_model_opt _ ">" _
tuple_element_list_model_opt ::= (tuple_element_model (_ "," _ tuple_element_model)*)?
tuple_element_model ::= tuple_comprehension_additive

// Non-empty tuple literal lists (model)
tuple_literal_list_model ::= tuple_literal_model ( _ "," _ tuple_literal_model )*

// Tuple comprehension (model)
tuple_comprehension ::= "<" _ tuple_comprehension_element_list _ ">" _ "|" _ sum_index_list _ opt_index_constraint
tuple_comprehension_element_list ::= tuple_comprehension_element ( _ "," _ tuple_comprehension_element )*
tuple_comprehension_element ::= tuple_comprehension_additive
tuple_comprehension_additive ::= tuple_comprehension_multiplicative ( _ ("+" | "-") _ tuple_comprehension_multiplicative )*
tuple_comprehension_multiplicative ::= tuple_comprehension_unary ( _ ("*" | "/" | "%") _ tuple_comprehension_unary )*
tuple_comprehension_unary ::= "-" _ tuple_comprehension_unary | tuple_comprehension_atom
tuple_comprehension_atom ::= NAME | NUMBER | STRING_LITERAL | BOOLEAN_LITERAL | tuple_literal_model | indexed_name | "(" _ tuple_comprehension_additive _ ")"
indexed_name ::= NAME _ tuple_comprehension_dimensions
tuple_comprehension_dimensions ::= ( "[" _ tuple_comprehension_additive _ "]" _ )+


// --- Arrays (nested) for inline params (.mod); scalar entries only ---
array_value ::= "[" _ row_list _ "]"
row_list ::=
      row_list _ "," _ scalar_value
    | scalar_value
    | row_list _ "," _ array_value
    | array_value

scalar_value ::= SIGNED_NUMBER | STRING_LITERAL | BOOLEAN_LITERAL


// ------------ DATA FILE (.dat) GRAMMAR ------------
data_file ::= data_declaration_list
data_declaration_list ::= data_declaration*

data_declaration ::=
    | NAME _ "=" _ data_scalar_value _ ";" _
    | NAME _ "=" _ set_value _ ";" _
    | NAME _ "=" _ data_array_value _ ";" _
    | NAME _ "=" _ key_value_array _ ";" _
    | NAME _ "=" _ DATA_NUMBER _ ".." _ DATA_NUMBER _ ";" _
    | set_of_tuples_data_assignment

// Set-of-tuples in .dat (untyped or typed)
set_of_tuples_data_assignment ::=
  NAME _ "=" _ "{" _ tuple_literal_list_data _ "}" _ ";" _

// set values for .dat scalar sets
set_value ::= "{" _ element_list_scalar _ "}"
element_list_scalar ::= data_scalar_value ( _ "," _ data_scalar_value )*

// Key-value arrays (string/tuple keys -> scalar or array)
key_value_array ::= "[" _ key_value_row_list _ "]"
key_value_row_list ::= key_value_row (_ "," _ key_value_row)* _ ("," _)?
key_value_row ::=
      STRING_LITERAL _ data_scalar_value
    | tuple_literal_data _ data_scalar_value
    | STRING_LITERAL _ data_array_value
    | tuple_literal_data _ data_array_value

// Data arrays may recursively contain scalars, tuple literals, and tuple-set values.
data_array_value ::= "[" _ data_row_list _ "]"
data_row_list ::=
      data_row_list _ "," _ data_scalar_value
    | data_scalar_value
    | data_row_list _ "," _ data_array_value
    | data_array_value
    | data_row_list _ "," _ tuple_literal_data
    | tuple_literal_data
    | data_row_list _ "," _ tuple_set_value
    | tuple_set_value

tuple_set_value ::=
      "{" _ tuple_literal_list_data _ "}"
    | "{" _ "}"

// Data tuple literals do NOT allow NAME elements.
// Empty tuples `<>` are allowed (align with implementation).
tuple_literal_data ::= "<" _ tuple_element_list_data _ ">" _
                  | "<" _ ">" _
tuple_element_list_data ::= tuple_element_data ( _ "," _ tuple_element_data )*
tuple_element_data ::= data_scalar_value | tuple_literal_data
data_scalar_value ::= DATA_NUMBER | STRING_LITERAL | BOOLEAN_LITERAL

// Non-empty tuple literal lists (data)
tuple_literal_list_data ::= tuple_literal_data ( _ "," _ tuple_literal_data )*

// --- Aggregates: parser only allows a non-parenthesized multiplicative body, or an explicit parenthesized body ---
nonparen_expression ::= multiplicative_expr
paren_expression ::= "(" _ expression _ ")"

min_aggregate ::= "min" _ sum_index_header _ nonparen_expression
              | "min" _ sum_index_header _ paren_expression
max_aggregate ::= "max" _ sum_index_header _ nonparen_expression
              | "max" _ sum_index_header _ paren_expression

sum_expression ::= "sum" _ sum_index_header _ nonparen_expression
               | "sum" _ sum_index_header _ paren_expression

// --- helpers used in param_declaration ---
opt_param_kw        ::= ("param" _)?                   // optional 'param' keyword
opt_indexed         ::= ( indexed_dimensions _ )?      // optional indexed dims
opt_assign_ellipsis ::= ( "=" _ "..." _ )?             // optional '= ...'